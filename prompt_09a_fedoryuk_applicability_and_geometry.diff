+#!/usr/bin/env python3
+"""Numerically trace the leading Fedoryuk quadratic-differential geometry."""
+
+from pathlib import Path
+
+import matplotlib as mpl
+import matplotlib.pyplot as plt
+import numpy as np
+from scipy.integrate import solve_ivp
+
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / "figures" / "fedoryuk_stokes_geometry"
+BLUE, ORANGE, INK = "#35618d", "#b66a3c", "#252525"
+
+
+def q0(z, e):
+    return (1 + 2 * e * z**2 - 2 * z**3) / z**4
+
+
+def roots(e):
+    return np.roots([-2, 2 * e, 0, 1])
+
+
+def trace(start, e, phase, length=5.0):
+    """Trace p dy/ds=phase, continuously choosing the square-root sign."""
+    last = [None]
+
+    def rhs(_s, state):
+        z = state[0] + 1j * state[1]
+        if abs(z) < 0.055 or abs(z) > 3.1:
+            return [0.0, 0.0]
+        root = np.sqrt(q0(z, e))
+        if last[0] is not None and abs(root - last[0]) > abs(-root - last[0]):
+            root = -root
+        last[0] = root
+        dz = phase / root
+        dz /= max(abs(dz), 1e-14)
+        return [dz.real, dz.imag]
+
+    sol = solve_ivp(rhs, (0, length), [start.real, start.imag],
+                    max_step=0.012, rtol=2e-7, atol=2e-9)
+    return sol.y[0], sol.y[1]
+
+
+def panel(ax, e, title):
+    rr = roots(e)
+    for root in rr:
+        multiplicity = 2 if abs(e + 1.5) < 1e-12 and abs(root + 1) < 1e-5 else 1
+        rays = 4 if multiplicity == 2 else 3
+        radius = 0.018 if multiplicity == 1 else 0.026
+        for family, phase, color, style in [
+            ("Stokes", 1j, BLUE, "-"), ("anti-Stokes", 1, ORANGE, "--")
+        ]:
+            for k in range(rays):
+                angle = 2 * np.pi * k / rays + (np.pi / (2 * rays) if family == "anti-Stokes" else 0)
+                start = root + radius * np.exp(1j * angle)
+                x, y = trace(start, e, phase)
+                ax.plot(x, y, style, color=color, lw=0.85, alpha=0.82)
+        ax.scatter(root.real, root.imag, s=30 if multiplicity == 2 else 22,
+                   marker="D" if multiplicity == 2 else "o", color=INK, zorder=5)
+    ax.scatter([0], [0], s=46, marker="x", color="#8b2e2e", lw=1.5, zorder=6)
+    ax.set(xlim=(-2.25, 1.55), ylim=(-1.65, 1.65), xlabel=r"$\Re y$", ylabel=r"$\Im y$")
+    ax.axhline(0, color="#dddddd", lw=.5)
+    ax.axvline(0, color="#dddddd", lw=.5)
+    ax.set_aspect("equal")
+    ax.set_title(title, fontsize=9)
+
+
+def main():
+    mpl.rcParams.update({"font.family": "serif", "mathtext.fontset": "stix",
+                         "font.size": 8.5, "pdf.fonttype": 42})
+    fig, axes = plt.subplots(1, 2, figsize=(7.15, 3.45), constrained_layout=True)
+    panel(axes[0], -1.45, r"separated roots: $e=-1.45$")
+    panel(axes[1], -1.5, r"coalescence: $e=-3/2$")
+    axes[0].plot([], [], color=BLUE, label=r"Fedoryuk Stokes: $\Re S=0$")
+    axes[0].plot([], [], "--", color=ORANGE, label=r"anti-Stokes: $\Im S=0$")
+    axes[0].scatter([], [], marker="x", color="#8b2e2e", label=r"pole $y=0$")
+    axes[0].legend(frameon=False, fontsize=7, loc="lower left")
+    fig.suptitle(r"Leading geometry of $p(y,e)^2=P(y;e)/y^4$", fontsize=10)
+    fig.savefig(OUT.with_suffix(".pdf"), bbox_inches="tight")
+    fig.savefig(OUT.with_suffix(".png"), dpi=450, bbox_inches="tight")
+    plt.close(fig)
+
+
+if __name__ == "__main__":
+    main()
