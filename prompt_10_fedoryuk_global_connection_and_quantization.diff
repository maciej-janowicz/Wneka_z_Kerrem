+#!/usr/bin/env python3
+"""Symbolic checks for the conditional Fedoryuk--Bargmann reduction.
+
+This script deliberately verifies only algebraic/local consequences.  It does
+not claim to prove the missing canonical-domain chain.
+"""
+
+import sympy as sp
+
+
+def verify():
+    eps = sp.symbols("epsilon", positive=True)
+    y, e1, e2, delta = sp.symbols("y e1 e2 delta", real=True)
+    n = sp.symbols("n", integer=True, nonnegative=True)
+    e = -sp.Rational(3, 2) + eps * e1 + eps**2 * e2
+    P = 1 + 2 * e * y**2 - 2 * y**3
+
+    # Puiseux roots of the leading cubic near the critical configuration.
+    v = sp.sqrt(-2 * e1 / 3)
+    w = 4 * e1 / 9
+    pair = (-1 + v * sp.sqrt(eps) + w * eps,
+            -1 - v * sp.sqrt(eps) + w * eps)
+    simple = sp.Rational(1, 2) + e1 * eps / 9
+    pair_residuals = tuple(sp.series(P.subs(y, root), eps, 0, 2).removeO()
+                           for root in pair)
+    simple_residual = sp.series(P.subs(y, simple), eps, 0, 2).removeO()
+    assert all(sp.simplify(value) == 0 for value in pair_residuals)
+    assert sp.simplify(simple_residual) == 0
+
+    # The two local Weber indices and the two signs of the first correction.
+    N = n + sp.Rational(1, 2)
+    e1_R = delta - 1 - sp.sqrt(3) * N
+    e1_I = delta - 1 + sp.sqrt(3) * N
+    Lambda = 2 * (e1 + 1 - delta) / sp.sqrt(3)
+    nu_R = -(Lambda + 1) / 2
+    nu_I = (Lambda - 1) / 2
+    assert sp.simplify(nu_R.subs(e1, e1_R) - n) == 0
+    assert sp.simplify(nu_I.subs(e1, e1_I) - n) == 0
+
+    # DLMF 12.2.19 in the D_nu convention.  Completing the first connection
+    # relation by the reciprocal diagonal normalization gives det M_W=1.
+    nu = sp.symbols("nu")
+    phase = sp.exp(-sp.I * sp.pi * nu)
+    c_weber = (sp.sqrt(2 * sp.pi) / sp.gamma(-nu)
+               * sp.exp(-sp.I * sp.pi * (nu + 1) / 2))
+    M_weber = sp.Matrix([[phase, c_weber], [0, 1 / phase]])
+    assert sp.simplify(M_weber.det() - 1) == 0
+    for level in range(6):
+        assert sp.simplify(c_weber.subs(nu, level)) == 0
+
+    # Gauge monodromy: Psi=y^{-delta} exp(1/(eps*y)) u.  A positive loop
+    # multiplies the gauge by exp(-2*pi*i*delta), hence u must carry the
+    # reciprocal factor for a single-valued Bargmann solution.
+    gauge_monodromy = sp.exp(-2 * sp.pi * sp.I * delta)
+    u_monodromy = sp.exp(2 * sp.pi * sp.I * delta)
+    assert sp.simplify(gauge_monodromy * u_monodromy - 1) == 0
+
+    e2_target = (delta * (1 - 2 * delta) / 6
+                 - (6 * n**2 + 6 * n + 1) / 72)
+    eta = sp.symbols("eta", positive=True)
+    energy = (-sp.Rational(3, 2) * eta**sp.Rational(4, 3)
+              + e1_I * eta**sp.Rational(2, 3) + e2_target)
+    target = (-sp.Rational(3, 2) * eta**sp.Rational(4, 3)
+              + (delta + sp.sqrt(3) * N - 1)
+              * eta**sp.Rational(2, 3) + e2_target)
+    assert sp.simplify(energy - target) == 0
+
+    return {
+        "turning_pair": pair,
+        "simple_turning_point": simple,
+        "nu_R": nu_R,
+        "nu_I": nu_I,
+        "e1_R": e1_R,
+        "e1_I": e1_I,
+        "weber_coefficient": c_weber,
+        "weber_matrix": M_weber,
+        "weber_determinant": sp.simplify(M_weber.det()),
+        "gauge_monodromy": gauge_monodromy,
+        "u_monodromy": u_monodromy,
+        "e2": e2_target,
+        "conditional_energy": energy,
+    }
+
+
+if __name__ == "__main__":
+    for key, value in verify().items():
+        print(f"{key} = {value}")
