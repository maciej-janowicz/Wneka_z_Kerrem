+import importlib.util
+from pathlib import Path
+
+import sympy as sp
+
+
+def _module():
+    path = (Path(__file__).parents[1] / "scripts" /
+            "10_verify_fedoryuk_global_reduction.py")
+    spec = importlib.util.spec_from_file_location("fedoryuk_global", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_turning_point_puiseux_expansions_and_weber_signs():
+    data = _module().verify()
+    assert len(data["turning_pair"]) == 2
+    assert sp.simplify(data["nu_R"].subs(
+        next(x for x in data["nu_R"].free_symbols if x.name == "e1"),
+        data["e1_R"]) - next(x for x in data["e1_R"].free_symbols
+                             if x.name == "n")) == 0
+
+
+def test_weber_transfer_is_unimodular_and_zeroes_at_integer_index():
+    data = _module().verify()
+    assert data["weber_determinant"] == 1
+    nu = next(x for x in data["weber_coefficient"].free_symbols
+              if x.name == "nu")
+    for level in range(8):
+        assert sp.simplify(data["weber_coefficient"].subs(nu, level)) == 0
+
+
+def test_gauge_and_transformed_monodromies_cancel():
+    data = _module().verify()
+    assert sp.simplify(data["gauge_monodromy"] * data["u_monodromy"] - 1) == 0
+
+
+def test_conditional_energy_contains_verified_local_constant():
+    data = _module().verify()
+    delta = next(x for x in data["e2"].free_symbols if x.name == "delta")
+    n = next(x for x in data["e2"].free_symbols if x.name == "n")
+    expected = delta * (1 - 2 * delta) / 6 - (6*n**2 + 6*n + 1) / 72
+    assert sp.simplify(data["e2"] - expected) == 0
